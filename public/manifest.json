{
    "manifest_version": 3,
    "name": "Grab Load",
    "version": "1.0",
    "description": "Automated freight dispatch tool",
    "permissions": ["activeTab", "storage", "scripting"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "index.html"
    },
    "host_permissions": ["*:https://loadconnect.io/*", "*://*.fmcsadatabase.com/*"],

    "content_scripts": [{
        "matches": [
            "https://loadconnect.io/*",
            "http://loadconnect.io/*",
            "*://*.loadconnect.io/*"
        ],
        "js": ["src/contentScripts/loadboardScraper.js"],
        "run_at": "document_idle"
    }]

}